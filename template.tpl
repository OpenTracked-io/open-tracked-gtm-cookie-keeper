___SANDBOXED_JS_FOR_SERVER___

const sendHttpRequest = require('sendHttpRequest');
const getEventData = require('getEventData');
const getCookieValues = require('getCookieValues');
const setCookie = require('setCookie');
const sha256Sync = require('sha256Sync');
const templateDataStorage = require('templateDataStorage');
const makeString = require('makeString');
const makeInteger = require('makeInteger');
const JSON = require('JSON');
const Promise = require('Promise');

// the cookies this template may look after (the permissions list the same names)
const ALLOWED = ['_fbp', '_fbc', '_ga', 'FPID', '_gcl_aw', '_gcl_dc', '_ttp', 'ttclid', '_os_vid', '__kla_id', '_scid', 'li_fat_id', '_uetmsclkid', '_uetvid', '_epik', '_pin_unauth'];

const who = getEventData(data.identifierKey || 'ot_bi');
if (!who) {
  data.gtmOnSuccess();
  return;
}
// the visitor is never stored under the identifier itself: only its hash
const key = 'ck:' + sha256Sync(makeString(who), {outputEncoding: 'hex'});

const names = [];
const wanted = (data.cookieNames || '').split(',');
for (let i = 0; i < wanted.length; i++) {
  const n = wanted[i].trim();
  if (n && ALLOWED.indexOf(n) > -1 && names.indexOf(n) === -1) {
    names.push(n);
  }
}

const present = {};
const missing = [];
for (let i = 0; i < names.length; i++) {
  const v = getCookieValues(names[i]);
  if (v && v.length && v[0]) {
    present['c_' + names[i]] = v[0];
  } else {
    missing.push(names[i]);
  }
}

let days = makeInteger(data.days);
if (!days || days < 1 || days > 400) {
  days = 400;
}
const url = data.apiUrl + '/entries/' + key;
const headers = {'Authorization': 'Bearer ' + data.token, 'Content-Type': 'application/json'};

function save() {
  const fingerprint = JSON.stringify(present);
  if (fingerprint === '{}' || templateDataStorage.getItemCopy('ck_' + key) === fingerprint) {
    return Promise.create(function(resolve) { resolve(); });         // nothing new since the last save from this server
  }
  return sendHttpRequest(url, {method: 'PUT', headers: headers, timeout: 3000}, JSON.stringify({value: present, ttl_days: days, merge: true})).then(function(r) {
    if (r.statusCode >= 200 && r.statusCode < 300) {
      templateDataStorage.setItemCopy('ck_' + key, fingerprint);
    }
  });
}

function restore() {
  if (missing.length === 0) {
    return Promise.create(function(resolve) { resolve(); });
  }
  return sendHttpRequest(url, {method: 'GET', headers: headers, timeout: 2000}).then(function(r) {
    if (r.statusCode !== 200) {
      return;
    }
    const parsed = JSON.parse(r.body);
    const stored = parsed && parsed.value ? parsed.value : {};
    for (let i = 0; i < missing.length; i++) {
      const v = stored['c_' + missing[i]];
      if (v) {
        setCookie(missing[i], makeString(v), {
          domain: data.domain || 'auto',
          path: '/',
          secure: true,
          httpOnly: false,
          samesite: 'Lax',
          'max-age': days * 86400
        });
      }
    }
  });
}

Promise.all([restore(), save()]).then(function() {
  data.gtmOnSuccess();
}).catch(function() {
  data.gtmOnSuccess();                    // keeping cookies is never a reason to fail an event
});


